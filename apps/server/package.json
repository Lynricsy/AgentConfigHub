{
  "name": "@agent-config-hub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run tests/auth-api.test.ts tests/admin-api-workflow.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@agent-config-hub/adapters": "workspace:*",
    "@agent-config-hub/protocol": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.0.0",
    "@taplo/cli": "^0.7.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.0.0"
  }
}
