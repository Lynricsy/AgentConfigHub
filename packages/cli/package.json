{
  "name": "agent-config-hub",
  "version": "0.1.0",
  "description": "Pull-only CLI for AgentConfigHub",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-config-hub": "dist/index.cjs"
  },
  "exports": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --alias:jsonc-parser=jsonc-parser/lib/esm/main.js --outfile=dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@agent-config-hub/adapters": "workspace:*",
    "@agent-config-hub/protocol": "workspace:*",
    "env-paths": "^4.0.0",
    "esbuild": "^0.28.1",
    "open": "^11.0.0",
    "zod": "^4.4.3"
  }
}
